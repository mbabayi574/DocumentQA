# Copy to .env and fill in. Never commit .env (see plan.md I8).

APP_ENV=dev                          # dev | test | demo | prod

# --- embedding service (no LLM/chat endpoint exists: embeddings only) ---
EMBEDDING_BASE_URL=https://models-interview.arvancloudai.ir/v1
EMBEDDING_API_KEY=                   # required when EMBEDDING_PROVIDER=remote
EMBEDDING_MODEL=                     # exact id from GET /v1/models, e.g. Bge-m3
EMBEDDING_PROVIDER=remote            # remote | fake (fake only in APP_ENV test/demo)
EMBEDDING_DIMENSION=                 # optional; if set, must equal the probed dimension

# --- storage (all local) ---
DATA_DIR=./data
SQLITE_PATH=./data/qasystem.db
CHROMA_PATH=./data/chroma
MAX_UPLOAD_MB=20

# --- chunking ---
CHUNK_TARGET_TOKENS=350
CHUNK_HARD_MAX_TOKENS=700
CHUNK_OVERLAP_RATIO=0.15

# --- embedding client ---
MAX_CHARS_PER_REQUEST=160000
# Bge-m3's context is 8192 tokens: 40k chars pass, 45k fail. Keep 2x headroom.
MAX_CHARS_PER_ITEM=20000
MAX_ITEMS_PER_BATCH=32
RATE_LIMIT_PER_MIN=100
REQUEST_TIMEOUT_S=30
MAX_RETRIES=5

# --- retrieval ---
CANDIDATES_N=30
OVERFETCH=2
TOP_K=5
RRF_K=60
DENSE_WEIGHT=0.9                   # measured on the eval dev split; see docs/eval_report.md
LEXICAL_WEIGHT=0.1                 # the lexical arm still earns 0.1: dense-only is worse

# --- gate + answer (written by `make calibrate`) ---
THRESHOLDS_PATH=./config/thresholds.json
MAX_ANSWER_SENTENCES=5